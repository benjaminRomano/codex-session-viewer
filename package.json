{
  "name": "codex-session-viewer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build:wasm && npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:wasm && bash scripts/rust-command.sh build --locked -p session-parser --bin session-parser && playwright test",
    "bench:browser": "node scripts/bench-browser.mjs",
    "bench:corpus": "bash scripts/rust-command.sh run --release -p session-parser --bin benchmark --",
    "check": "npm run check:ts && npm run check:rust",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "check:unused": "knip",
    "lint:rust": "bash scripts/rust-command.sh clippy --locked --workspace --all-targets -- -D warnings",
    "format:rust": "bash scripts/rust-command.sh fmt --all",
    "format:rust:check": "bash scripts/rust-command.sh fmt --all --check",
    "check:ts": "npm run typecheck && npm run lint && npm run format:check && npm run check:unused && npm test",
    "check:rust": "npm run format:rust:check && npm run lint:rust && bash scripts/rust-command.sh test --locked --workspace",
    "deploy:vercel": "node scripts/deploy-vercel.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.11",
    "highlight.js": "11.12.0",
    "hsluv": "1.0.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "knip": "6.34.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "packageManager": "npm@12.0.2"
}
